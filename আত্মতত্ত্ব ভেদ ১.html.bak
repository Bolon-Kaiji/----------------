</script>
<script>
  // Authentic 26 real books from extracted_books.txt + extended global texts up to 45
  const authenticBooks = [
    { id: 1, title: 'আত্মতত্ত্ব ভেদ [মানবদেহ] (১ম খণ্ড)', sub: 'মানুষের উদ্ভব ও সভ্যতার ক্রমবিকাশ', cat: 'dhorom', icon: '👤', parts: '১ম খণ্ড' },
    { id: 2, title: 'আত্মতত্ত্ব ভেদ [মন, জ্ঞান ও আত্মা] (২য় খণ্ড)', sub: 'মানসিক শক্তি ও আত্মোপলব্ধি', cat: 'dhorom', icon: '🧠', parts: '২য় খণ্ড' },
    { id: 3, title: 'আত্মতত্ত্ব ভেদ [সংস্কার ও আবিষ্কার] (৩য় খণ্ড)', sub: 'প্রথা ও আত্মিক নবায়ন', cat: 'dhorom', icon: '🔬', parts: '৩য় খণ্ড' },
    { id: 4, title: 'আত্মতত্ত্ব ভেদ [লৌকিক-অলৌকিক] (৪র্থ খণ্ড)', sub: 'দৃশ্য ও অদৃশ্যের সংযোগসূত্র', cat: 'dhorom', icon: '🔮', parts: '৪র্থ খণ্ড' },
    { id: 5, title: 'আত্মতত্ত্ব ভেদ [পঞ্চরস] (৫ম খণ্ড)', sub: 'ভাবরস ও আধ্যাত্মিক আস্বাদন', cat: 'dhorom', icon: '🍯', parts: '৫ম খণ্ড' },
    { id: 6, title: 'আত্মতত্ত্ব ভেদ [শয়তানের পরিচয়] (৬ষ্ঠ খণ্ড)', sub: 'কুপ্রবৃত্তি ও রিপু দমন তত্ত্ব', cat: 'dhorom', icon: '⚡', parts: '৬ষ্ঠ খণ্ড' },
    { id: 7, title: 'আত্মতত্ত্ব ভেদ [সৃষ্টিকর্তার পরিচয়] (৭ম খণ্ড)', sub: 'পরমসত্তা ও স্রষ্টার স্বরূপ', cat: 'dhorom', icon: '☀️', parts: '৭ম খণ্ড' },
    { id: 8, title: 'আত্মতত্ত্ব ভেদ [পৌরাণিক সংখ্যা] (৮ম খণ্ড)', sub: 'সংখ্যাতত্ত্ব ও মহাজাগতিক রহস্য', cat: 'dhorom', icon: '🔢', parts: '৮ম খণ্ড' },
    { id: 9, title: 'উৎসের সন্ধান', sub: 'আধ্যাত্মিকবিদ্যা পরিচিতি [মারিফাত তত্ত্ব/ জ্ঞানতত্ত্ব]', cat: 'mohagrontho', icon: '🧭', parts: 'মহাগ্রন্থ' },
    { id: 10, title: 'জপসার পরম্পরা সমগ্র', sub: 'পরম্পরা তত্ত্ব ভেদ [তাসাউফ (تَصَوُّفٌ) তত্ত্ব] (১ম খণ্ড)', cat: 'mohagrontho', icon: '📿', parts: '১ম খণ্ড' },
    { id: 11, title: 'পরম্পরা তত্ত্ব ভেদ [আত্মশুদ্ধি]', sub: 'তাসাউফ ও আত্মশুদ্ধির ক্রমপর্যায় (২য় খণ্ড)', cat: 'mohagrontho', icon: '💧', parts: '২য় খণ্ড' },
    { id: 12, title: 'চার ত্বরিক্বার বিধিবিধান', sub: 'ত্বরিক্বত দর্শন [সাম্প্রদায়িক ও পারম্পরিক উপাসনা]', cat: 'mohagrontho', icon: '🕌', parts: 'ত্বরিক্বত' },
    { id: 13, title: 'মাটির বোমায় স্বর্গ-নরক', sub: 'আত্মার সৃষ্টিরহস্য ও আত্মমুক্তির পথ', cat: 'mohagrontho', icon: '🌍', parts: 'তত্ত্ব' },
    { id: 14, title: 'গুরু জ্ঞানকোষ', sub: 'সাধক ও শিষ্যের মার্গ সহায়িকা', cat: 'mohagrontho', icon: '📖', parts: 'সহায়িকা' },
    { id: 15, title: 'আধ্যাত্মিক সূত্রাবলী ও টীকা সমগ্র', sub: 'গভীর তত্ত্বজ্ঞানের মূলভাষ্য', cat: 'mohagrontho', icon: '📑', parts: 'সমগ্র' },
    { id: 16, title: 'ঢাকা হাইকোর্ট চত্বরে নারী মূর্তি স্থাপনের রহস্য', sub: 'মূর্তি ভাঙ্গা মূর্তি গড়া [৩৬০ ঐশি মূর্তি]', cat: 'mohagrontho', icon: '⚖️', parts: 'ঐতিহাসিক' },
    { id: 17, title: 'দিব্যজ্ঞান', sub: 'পরম চেতনার আলো ও আলোকপ্রাপ্তি', cat: 'mohagrontho', icon: '✨', parts: 'দিব্যগ্রন্থ' },
    { id: 18, title: 'মু’জিযার ইতিবৃত্ত', sub: 'অলৌকিক চমৎকারের রহস্য ও বাস্তবতা', cat: 'mohagrontho', icon: '🌌', parts: 'ইতিবৃত্ত' },
    { id: 19, title: 'লালন রহস্যভেদ সমগ্র', sub: 'সাঁইজির গুহ্য তত্ত্ব ও বাণীর বিশ্লেষণ', cat: 'lalon', icon: '🕊️', parts: 'রহস্যভেদ' },
    { id: 20, title: 'পবিত্র লালন (বিশুদ্ধ সংস্করণ)', sub: 'প্রামাণ্য মূল বাণী ও শাস্ত্রীয় পদাবলী', cat: 'lalon', icon: '📜', parts: 'বিশুদ্ধ সং.' },
    { id: 21, title: 'হাজার লালন (বিশুদ্ধ সংস্করণ)', sub: 'এক সহস্র মূল ভাবপদ ও টীকা', cat: 'lalon', icon: '📚', parts: 'সহস্র সং.' },
    { id: 22, title: 'লালন ঘরানা', sub: 'পারম্পরিক আখড়া ও সাধুসঙ্গের ধারা', cat: 'lalon', icon: '🛖', parts: 'ঘরানা' },
    { id: 23, title: 'বাঙালী মহামানব: লালন সাঁইজি', sub: 'সাঁইজির প্রামাণ্য ঐতিহাসিক জীবনী ও দর্শন', cat: 'lalon', icon: '👑', parts: 'জীবনী' },
    { id: 24, title: 'বলন তত্ত্বাবলী (১ম খণ্ড)', sub: 'কাঁইজির স্বরচিত মূল সাধন সঙ্গীত ও দর্শন', cat: 'lalon', icon: '🎵', parts: '১ম খণ্ড' },
    { id: 25, title: 'লালন আধ্যাত্মিক অভিধান', sub: 'বাণীর দুরূহ আধ্যাত্মিক শব্দের সঠিক পরিভাষা', cat: 'lalon', icon: '📘', parts: 'অভিধান' },
    { id: 26, title: 'লালন ভাবার্থের আধ্যাত্মিক অভিধান', sub: 'গূঢ় পদাবলীর অর্থ ও রূপক ব্যাখ্যান', cat: 'lalon', icon: '📗', parts: 'অভিধান' }
  ];

  // Fill up to 45 titles for the full global repertoire
  for (let i = 27; i <= 45; i++) {
    const cats = ['dhorom', 'mohagrontho', 'lalon'];
    const assignedCat = cats[i % 3];
    authenticBooks.push({
      id: i,
      title: `বৈশ্বিক শাস্ত্র ও পরম তত্ত্ব সংকলন (খণ্ড ${i})`,
      sub: 'বিশ্বধর্মীয় সমন্বয় ও কাঁই দর্শনের আন্তর্জাতিক তুলনামূলক কোষ',
      cat: assignedCat,
      icon: '🏛️',
      parts: `খণ্ড ${i}`
    });
  }

  // Render books
  function renderBooks(filter = 'all') {
    const container = document.getElementById('booksContainer');
    const filtered = filter === 'all' ? authenticBooks : authenticBooks.filter(b => b.cat === filter);

    container.innerHTML = filtered.map(b => `
      <div class="book-item">
        <div>
          <div class="book-item-header">
            <span class="book-badge">${b.parts}</span>
            ${b.fileName ? `<span class="book-badge" style="margin-left:6px; background:rgba(47,164,79,0.15); color:#2ea44f;">📄 ডক</span>` : ''}
            <span class="book-num">#${b.id.toString().padStart(2, '০')}</span>
          </div>
          ${b.coverImage ? `<img src="${b.coverImage}" alt="" style="width:100%; height:140px; object-fit:cover; border-radius:8px; margin:6px 0 10px; border:1px solid var(--gold);">` : ''}
          <div class="book-title">${b.title}</div>
          <div class="book-desc">${b.sub}</div>
        </div>
        <div class="book-item-footer">
          <span style="font-size:12px; color:var(--gold); font-weight:bold;">
            ${b.cat === 'dhorom' ? 'ধর্মগ্রন্থ' : (b.cat === 'mohagrontho' ? 'মহাগ্রন্থ' : 'পবিত্র লালন')}
          </span>
          <button class="btn-read-inside" onclick="openBookReader(${b.id})">
            📖 ভিতরের ইন্টারফেস দেখুন
          </button>
        </div>
      </div>
    `).join('');
  }

  function filterBooks(cat, btn) {
    if (btn) {
      document.querySelectorAll('.filter-tab').forEach(t => t.classList.remove('active'));
      btn.classList.add('active');
    }
    renderBooks(cat);
  }

  // View Switching
  function showPortal() {
    document.body.classList.remove('reader-mode');
    document.getElementById('portalView').style.display = 'block';
    document.getElementById('readerView').style.display = 'none';
    window.scrollTo({ top: 0, behavior: 'smooth' });
  }

  function openBookReader(bookId) {
    const book = authenticBooks.find(b => b.id === bookId) || authenticBooks[0];

    // Update reader headers & Infobox dynamically
    document.getElementById('readerBookTitle').textContent = book.title;
    document.getElementById('ibTitle').textContent = book.title;
    document.getElementById('ibName').textContent = book.title;
    document.getElementById('ibSub').textContent = book.sub;
    document.getElementById('ibSeries').textContent = book.parts;
    document.getElementById('ibBranch').textContent =
      book.cat === 'dhorom' ? 'বৈশ্বিক ধর্মগ্রন্থসমূহ' : (book.cat === 'mohagrontho' ? 'বৈশ্বিক মহাগ্রন্থসমূহ' : 'পবিত্র লালন ও সাঁইজি শাস্ত্র');

    const coverImg = document.getElementById('ibCoverImage');
    const emblem = document.getElementById('ibEmblem');
    const coverCaption = document.getElementById('ibCoverCaption');
    if (book.coverImage) {
      coverImg.src = book.coverImage;
      coverImg.style.display = 'block';
      if (emblem) emblem.style.display = 'none';
      if (coverCaption) coverCaption.textContent = 'গ্রন্থের আসল প্রচ্ছদ';
    } else {
      coverImg.style.display = 'none';
      if (emblem) {
        emblem.style.display = 'inline-flex';
        emblem.textContent = book.title.charAt(0);
      }
      if (coverCaption) coverCaption.textContent = 'কাঁই ফাউন্ডেশন সনদভুক্ত প্রতীকী প্রচ্ছদ';
    }

    const authorImg = document.getElementById('ibAuthorPhoto');
    const authorPlaceholder = document.getElementById('ibAuthorPlaceholder');
    const authorCaption = document.getElementById('ibAuthorCaption');
    if (book.authorImage) {
      authorImg.src = book.authorImage;
      authorImg.style.display = 'block';
      if (authorPlaceholder) authorPlaceholder.style.display = 'none';
    } else {
      authorImg.style.display = 'none';
      if (authorPlaceholder) authorPlaceholder.style.display = 'inline-flex';
    }
    if (authorCaption) {
      authorCaption.textContent = 'লেখক: ' + (book.author || 'বলন কাঁইজি');
    }
    const ibAuthor = document.getElementById('ibAuthor');
    if (ibAuthor) ibAuthor.textContent = book.author || 'বলন কাঁইজি';

    // Manuscript content (uploaded DOCX/TXT/PDF) or default demo article
    renderReaderContent(book);

    const subEl = document.getElementById('readerBookSubtitle');
    if (subEl) {
      subEl.textContent = book.fileName
        ? 'মিথোস্কোপিডিয়া · মুক্ত জ্ঞানকোষ থেকে সংগৃহীত'
        : 'বলন কাঁইজি আদলে কাঁই ফাউন্ডেশনের সংরক্ষিত মহাতত্ত্ব কোষ · বিশুদ্ধ সংস্করণ';
    }

    // Switch view
    document.body.classList.add('reader-mode');
    document.getElementById('portalView').style.display = 'none';
    document.getElementById('readerView').style.display = 'block';
    window.scrollTo({ top: 0, behavior: 'smooth' });
  }

  // Live preview when a file is chosen
  function wireImagePreview(inputId, previewBoxId, previewImgId) {
    const input = document.getElementById(inputId);
    if (!input) return;
    input.addEventListener('change', () => {
      const file = input.files && input.files[0];
      const box = document.getElementById(previewBoxId);
      const img = document.getElementById(previewImgId);
      if (!file) { if (box) box.classList.remove('visible'); return; }
      const reader = new FileReader();
      reader.onload = e => {
        if (img) img.src = e.target.result;
        if (box) box.classList.add('visible');
      };
      reader.readAsDataURL(file);
    });
  }
  wireImagePreview('upCover', 'coverPreview', 'coverPreviewImage');
  wireImagePreview('upAuthorPhoto', 'authorPhotoPreview', 'authorPhotoPreviewImage');

  function readFileAsDataURL(file) {
    return new Promise(resolve => {
      if (!file) { resolve(null); return; }
      const reader = new FileReader();
      reader.onload = e => resolve(e.target.result);
      reader.readAsDataURL(file);
    });
  }

  // ===== Manuscript (DOCX / TXT / PDF) handling =====
  function readFileAsArrayBuffer(file) {
    return new Promise((resolve, reject) => {
      const r = new FileReader();
      r.onload = e => resolve(e.target.result);
      r.onerror = () => reject(r.error);
      r.readAsArrayBuffer(file);
    });
  }

  function escapeHtml(s) {
    return String(s).replace(/[&<>"']/g, c => (
      { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]
    ));
  }

  const MAMMOTH_URLS = [
    'https://cdn.jsdelivr.net/npm/mammoth@1.8.0/mammoth.browser.min.js',
    'https://unpkg.com/mammoth@1.8.0/mammoth.browser.min.js'
  ];

  let mammothLoading = null;
  function ensureMammoth() {
    if (typeof mammoth !== 'undefined') return Promise.resolve(mammoth);
    if (mammothLoading) return mammothLoading;
    mammothLoading = new Promise((resolve, reject) => {
      let idx = 0;
      const tryNext = () => {
        if (idx >= MAMMOTH_URLS.length) {
          reject(new Error('DOCX রূপান্তরকারী লোড করা যায়নি — ইন্টারনেট সংযোগ নেই বা CDN ব্লকড।'));
          return;
        }
        const s = document.createElement('script');
        s.src = MAMMOTH_URLS[idx++];
        s.onload = () => (typeof mammoth !== 'undefined'
          ? resolve(mammoth)
          : tryNext());
        s.onerror = () => tryNext();
        document.head.appendChild(s);
      };
      tryNext();
    });
    return mammothLoading;
  }

  async function docxFileToHtml(file) {
    const m = await ensureMammoth();
    const arrayBuffer = await readFileAsArrayBuffer(file);
    try {
      const result = await m.convertToHtml(
        { arrayBuffer: arrayBuffer },
        { includeDefaultStyleMap: true }
      );
      return result.value || '';
    } catch (convErr) {
      console.warn('HTML রূপান্তর ব্যর্থ — সরাসরি টেক্সট নেওয়া হচ্ছে', convErr);
      const raw = await m.extractRawText({ arrayBuffer: arrayBuffer });
      const text = (raw && raw.value) ? raw.value : '';
      if (!text.trim()) throw convErr;
      return text.split(/\n\s*\n/)
        .map(p => `<p>${escapeHtml(p.trim()).replace(/\n/g, '<br>')}</p>`)
        .join('');
    }
  }

  async function buildManuscript(file) {
    const name = file.name || 'manuscript';
    const ext = (name.split('.').pop() || '').toLowerCase();

    if (ext === 'docx') {
      const html = await docxFileToHtml(file);
      if (!html || !html.trim()) {
        throw new Error('ফাইলটি থেকে কোনো লেখা পাওয়া যায়নি — ডকুমেন্টটি আবার পরীক্ষা করুন।');
      }
      return { fileName: name, contentType: 'html', contentHtml: html };
    }

    if (ext === 'txt' || ext === 'md') {
      const text = await file.text();
      const html = text.split(/\n\s*\n/).map(p =>
        `<p>${escapeHtml(p.trim()).replace(/\n/g, '<br>')}</p>`
      ).join('');
      return { fileName: name, contentType: 'html', contentHtml: html };
    }

    if (ext === 'pdf') {
      const data = await readFileAsDataURL(file);
      return { fileName: name, contentType: 'pdf', contentData: data };
    }

    if (ext === 'doc') {
      throw new Error('পুরোনো .doc ফরম্যাট এখানে পড়া যায় না। ফাইলটি Word-এ খুলে "Save As" থেকে .docx হিসেবে সেভ করে আবার চেষ্টা করুন।');
    }

    throw new Error('এই ফাইল ফরম্যাট সমর্থিত নয়। শুধু .docx, .txt ও .pdf ব্যবহার করুন।');
  }

  function applyManuscript(book, manuscript) {
    book.fileName = manuscript.fileName;
    book.contentType = manuscript.contentType;
    book.contentHtml = manuscript.contentHtml || null;
    book.contentData = manuscript.contentData || null;
    book.hasManuscript = true;
  }

  // ===== Manuscript persistence (localStorage, quota-safe) =====
  const CONTENT_KEY = 'kaiBookContent';

  function persistBookContent() {
    const payload = {};
    authenticBooks.forEach(b => {
      if (b.fileName) {
        payload[b.id] = {
          fileName: b.fileName,
          contentType: b.contentType || 'html',
          contentHtml: b.contentHtml || null,
          contentData: b.contentData || null
        };
      }
    });
    try {
      localStorage.setItem(CONTENT_KEY, JSON.stringify(payload));
      return true;
    } catch (e) {
      try {
        const metaOnly = {};
        Object.keys(payload).forEach(k => {
          metaOnly[k] = { fileName: payload[k].fileName, contentType: payload[k].contentType, contentHtml: null, contentData: null };
        });
        localStorage.setItem(CONTENT_KEY, JSON.stringify(metaOnly));
      } catch (e2) { /* private mode */ }
      return false;
    }
  }

  function restoreBookContent() {
    try {
      const raw = localStorage.getItem(CONTENT_KEY);
      if (!raw) return;
      const saved = JSON.parse(raw);
      Object.keys(saved).forEach(k => {
        const b = authenticBooks.find(x => x.id === Number(k));
        if (!b) return;
        const s = saved[k] || {};
        if (s.fileName) {
          b.fileName = s.fileName;
          b.contentType = s.contentType || 'html';
          b.contentHtml = s.contentHtml || null;
          b.contentData = s.contentData || null;
          b.hasManuscript = true;
        }
      });
    } catch (e) { /* ignore */ }
  }

  function showUploadError(msg) {
    alert('পাণ্ডুলিপি প্রসেস করা যায়নি। নিচের কারণটি দেখুন:\n\n' + msg);
    let box = document.getElementById('uploadErrorBox');
    if (!box) {
      box = document.createElement('div');
      box.id = 'uploadErrorBox';
      box.style.cssText = 'max-width:850px;margin:18px auto 0;background:#3a1d1d;border:1px solid #d9534f;color:#ffd7d7;padding:14px 18px;border-radius:10px;font-size:14.5px;white-space:pre-wrap;font-family:var(--font-bn);line-height:1.7;';
      const upBox = document.querySelector('.upload-box');
      if (upBox) upBox.appendChild(box);
    }
    box.textContent = '⚠️ ব্যর্থতার কারণ: ' + msg;
    box.scrollIntoView({ behavior: 'smooth', block: 'center' });
  }

  // Handle user's upload interaction
  async function handleSimulatedUpload() {
    const targetVal = document.getElementById('upTargetBook').value;
    const title = document.getElementById('upTitle').value.trim() || 'নতুন সংযোজিত মহাতত্ত্ব গ্রন্থ';
    const cat = document.getElementById('upCat').value;
    const author = document.getElementById('upAuthor').value.trim() || 'বলন কাঁইজি';
    const coverInput = document.getElementById('upCover');
    const authorInput = document.getElementById('upAuthorPhoto');
    const fileInput = document.getElementById('upFile');
    const coverFile = coverInput && coverInput.files ? coverInput.files[0] : null;
    const authorFile = authorInput && authorInput.files ? authorInput.files[0] : null;
    const manuscriptFile = fileInput && fileInput.files ? fileInput.files[0] : null;

    const submitBtn = document.querySelector('.btn-upload-submit');
    if (submitBtn) {
      submitBtn.disabled = true;
      submitBtn.dataset.label = submitBtn.textContent;
      submitBtn.textContent = '⏳ পাণ্ডুলিপি প্রসেস হচ্ছে...';
    }

    let manuscript = null;
    const oldErr = document.getElementById('uploadErrorBox');
    if (oldErr) oldErr.remove();
    try {
      if (manuscriptFile) manuscript = await buildManuscript(manuscriptFile);

      const [coverImage, authorImage] = await Promise.all([
        readFileAsDataURL(coverFile),
        readFileAsDataURL(authorFile)
      ]);

      if (targetVal !== 'new') {
        const bookId = parseInt(targetVal);
        const book = authenticBooks.find(b => b.id === bookId);
        if (book) {
          book.title = title;
          book.cat = cat;
          book.author = author;
          if (coverImage) book.coverImage = coverImage;
          if (authorImage) book.authorImage = authorImage;
          if (manuscript) applyManuscript(book, manuscript);
          const persisted = persistBookContent();
          persistBookMedia();
          renderBooks();
          initTargetBookSelect();
          document.getElementById('upTargetBook').value = String(bookId);
          if (fileInput) fileInput.value = '';
          alert(`"${title}" গ্রন্থের তথ্য${manuscript ? ', পাণ্ডুলিপি' : ''}, প্রচ্ছদ ও লেখকের ছবি সফলভাবে যুক্ত হয়েছে!${persisted ? '' : '\n(নথিপত্রটি ব্রাউজারে সংরক্ষিত হয়নি — আকার বড়; এই সেশনেই দেখা যাবে)'} এখন ভিতরের ইন্টারফেসে দেখানো হচ্ছে...`);
          openBookReader(bookId);
          return;
        }
      }

      const newBook = {
        id: authenticBooks.length + 1,
        title: title,
        sub: 'আপলোডকৃত পাণ্ডুলিপি · বলন কাঁইজি ফরম্যাট প্রস্তুত',
        cat: cat,
        icon: '📑',
        parts: 'নব সংযোজন',
        author: author,
        coverImage: coverImage,
        authorImage: authorImage
      };
      if (manuscript) applyManuscript(newBook, manuscript);
      authenticBooks.unshift(newBook);
      const persisted = persistBookContent();
      persistBookMedia();
      renderBooks();
      initTargetBookSelect();
      document.getElementById('upTargetBook').value = String(newBook.id);
      if (fileInput) fileInput.value = '';
      alert(`"${title}" গ্রন্থটি সফলভাবে নতুন সংযোজন হিসেবে প্রসেস করা হয়েছে!${persisted ? '' : '\n(নথিপত্রটি ব্রাউজারে সংরক্ষিত হয়নি — আকার বড়; এই সেশনেই দেখা যাবে)'} এখন ভিতরের ইন্টারফেসে নিয়ে যাওয়া হচ্ছে...`);
      openBookReader(newBook.id);
    } catch (err) {
      const detail = (err && err.message) ? err.message : String(err);
      console.error('[পাণ্ডুলিপি আপলোড]', err);
      showUploadError(detail + (manuscriptFile ? '\nফাইল: ' + manuscriptFile.name : ''));
    } finally {
      if (submitBtn) {
        submitBtn.disabled = false;
        submitBtn.textContent = submitBtn.dataset.label || '📥 আপলোড করে ভিতরের ইন্টারফেসে খুলুন';
      }
    }
  }

  // ===== Reader content rendering for uploaded manuscripts =====
  const defaultTocHTML = (() => {
    const ul = document.getElementById('wikiTocList');
    return ul ? ul.innerHTML : '';
  })();

  function buildDocToc(container) {
    const ul = document.getElementById('wikiTocList');
    if (!ul) return;
    const heads = Array.from(container.querySelectorAll('h1, h2, h3, h4'));
    if (!heads.length) {
      ul.innerHTML = '<li><span style="color:#54595d;">এই নথিপত্রে শিরোনাম পাওয়া যায়নি</span></li>';
      return;
    }
    let html = '';
    let open = 0;
    heads.forEach((h, i) => {
      const hid = 'doc-h-' + i;
      h.id = hid;
      const level = Math.min(3, parseInt(h.tagName.substring(1), 10));
      while (open < level - 1) { html += '<ul class="sub-toc">'; open++; }
      while (open > level - 1) { html += '</ul>'; open--; }
      const label = (h.textContent || '').trim() || ('শিরোনাম ' + (i + 1));
      html += `<li><a href="#${hid}">${escapeHtml(label)}</a></li>`;
    });
    while (open > 0) { html += '</ul>'; open--; }
    ul.innerHTML = html;
  }

  function enhanceDocContent(container) {
    const heads = Array.from(container.querySelectorAll('h2, h3'));
    heads.forEach(h => {
      const level = parseInt(h.tagName.substring(1), 10);
      const toggle = document.createElement('span');
      toggle.className = 'wiki-toggle';
      toggle.textContent = '[লুকান]';
      toggle.title = 'এই অনুচ্ছেদটি লুকান';
      toggle.addEventListener('click', () => {
        const hidden = [];
        let n = h.nextElementSibling;
        while (n) {
          const tag = n.tagName || '';
          const isHead = /^H[1-6]$/.test(tag);
          if (isHead && parseInt(tag.substring(1), 10) <= level) break;
          hidden.push(n);
          n = n.nextElementSibling;
        }
        if (!hidden.length) return;
        const willHide = hidden[0].style.display !== 'none';
        hidden.forEach(el => { el.style.display = willHide ? 'none' : ''; });
        toggle.textContent = willHide ? '[দেখান]' : '[লুকান]';
      });
      h.appendChild(toggle);
    });
  }

  function appendDocCategories(container, book) {
    const catName = book.cat === 'dhorom' ? 'বৈশ্বিক ধর্মগ্রন্থসমূহ'
      : (book.cat === 'mohagrontho' ? 'বৈশ্বিক মহাগ্রন্থসমূহ' : 'পবিত্র লালন ও সাঁইজি শাস্ত্র');
    const div = document.createElement('div');
    div.className = 'wiki-catlinks';
    div.innerHTML = '<b>বিষয়শ্রেণীসমূহ:</b> ' +
      '<a href="javascript:void(0)">কাঁই ফাউন্ডেশনের গ্রন্থাবলী</a> | ' +
      '<a href="javascript:void(0)">' + escapeHtml(catName) + '</a> | ' +
      '<a href="javascript:void(0)">বলন কাঁইজি রচিত দর্শন</a> | ' +
      '<a href="javascript:void(0)">ডিজিটাল পাণ্ডুলিপি সংগ্রহ</a>';
    container.appendChild(div);
  }

  function toggleToc() {
    const list = document.getElementById('wikiTocList');
    const btn = document.getElementById('tocToggle');
    if (!list || !btn) return;
    const hidden = list.style.display === 'none';
    list.style.display = hidden ? '' : 'none';
    btn.textContent = hidden ? '[লুকান]' : '[দেখান]';
  }

  function wikiTabInfo(name) {
    const t = document.getElementById('wikiToast');
    if (!t) return;
    t.textContent = name + ' — এই অংশটি ডেমো সংস্করণে নিষ্ক্রিয়';
    t.classList.add('show');
    clearTimeout(wikiTabInfo._timer);
    wikiTabInfo._timer = setTimeout(() => t.classList.remove('show'), 2200);
  }

  function renderReaderContent(book) {
    const docBox = document.getElementById('readerDocContent');
    const defBox = document.getElementById('readerDefaultContent');
    const toc = document.getElementById('wikiTocList');
    const fileRow = document.getElementById('ibFileRow');
    const fileNameCell = document.getElementById('ibFileName');
    if (!docBox || !defBox) return;

    const hasDoc = !!(book && (book.contentHtml || book.contentData));

    if (hasDoc) {
      defBox.style.display = 'none';
      docBox.style.display = 'block';
      const fname = book.fileName || 'পাণ্ডুলিপি';

      if (book.contentType === 'pdf') {
        docBox.innerHTML =
          `<div class="doc-filebar">📄 ${escapeHtml(fname)} — PDF নথিপত্র</div>` +
          `<iframe src="${book.contentData}" title="${escapeHtml(fname)}"></iframe>`;
        if (toc) toc.innerHTML = '<li><span style="color:#54595d;">PDF নথিপত্র — সূচিপত্র নেই</span></li>';
      } else {
        const kind = /\.docx$/i.test(fname) ? 'Word ডকুমেন্ট রূপান্তরিত' : 'পাঠ্য নথিপত্র';
        docBox.innerHTML =
          `<div class="doc-filebar">📝 ${escapeHtml(fname)} — ${kind}</div>` +
          (book.contentHtml || '');
        buildDocToc(docBox);
        enhanceDocContent(docBox);
        appendDocCategories(docBox, book);
      }

      if (fileRow) fileRow.style.display = '';
      if (fileNameCell) fileNameCell.textContent = fname;
    } else if (book && book.fileName) {
      // Metadata restored but content missing (file too large for localStorage)
      defBox.style.display = 'none';
      docBox.style.display = 'block';
      docBox.innerHTML =
        `<div class="doc-filebar">⚠️ ${escapeHtml(book.fileName)} — এই নথিপত্রের কনটেন্ট ব্রাউজারে সংরক্ষিত হয়নি (ফাইলটি আকারে বড়)। আবার আপলোড করলে সম্পূর্ণ লেখা দেখা যাবে।</div>`;
      if (toc) toc.innerHTML = '';
      if (fileRow) fileRow.style.display = '';
      if (fileNameCell) fileNameCell.textContent = book.fileName;
    } else {
      docBox.style.display = 'none';
      docBox.innerHTML = '';
      defBox.style.display = 'block';
      if (toc && defaultTocHTML) toc.innerHTML = defaultTocHTML;
      if (fileRow) fileRow.style.display = 'none';
      if (fileNameCell) fileNameCell.textContent = '';
    }
  }
  // Reader Controls
  function toggleReaderTheme() {
    document.body.classList.toggle('reader-dark');
  }

  let currentFontSize = 16.5;
  function adjustFontSize(delta) {
    currentFontSize = Math.max(14, Math.min(24, currentFontSize + delta));
    document.querySelectorAll('.wiki-para, .wiki-lead-para, .doc-content p, .doc-content li, .doc-content td, .doc-content th').forEach(el => {
      el.style.fontSize = currentFontSize + 'px';
    });
  }

  // Populate target select options dynamically
  function initTargetBookSelect() {
    const sel = document.getElementById('upTargetBook');
    if (!sel) return;
    let html = '';
    authenticBooks.forEach(b => {
      html += `<option value="${b.id}">${b.id}. ${b.title} (${b.parts || ''})</option>`;
    });
    html += `<option value="new">➕ নতুন গ্রন্থ হিসেবে যুক্ত করুন</option>`;
    sel.innerHTML = html;
  }

  function onTargetBookChange(val) {
    if (val !== 'new') {
      const b = authenticBooks.find(x => x.id == val);
      if (b) {
        document.getElementById('upTitle').value = b.title;
        document.getElementById('upCat').value = b.cat || 'dhorom';
        document.getElementById('upAuthor').value = b.author || 'বলন কাঁইজি';
      }
    }
  }

  function persistBookMedia() {
    try {
      const payload = authenticBooks
        .filter(b => b.coverImage || b.authorImage)
        .map(b => ({
          id: b.id,
          coverImage: b.coverImage || null,
          authorImage: b.authorImage || null,
          author: b.author || ''
        }));
      localStorage.setItem('kaiBookMedia', JSON.stringify(payload));
    } catch (e) { /* quota or private mode */ }
  }

  function restoreBookMedia() {
    try {
      const raw = localStorage.getItem('kaiBookMedia');
      if (!raw) return;
      JSON.parse(raw).forEach(saved => {
        const b = authenticBooks.find(x => x.id === saved.id);
        if (!b) return;
        if (saved.coverImage) b.coverImage = saved.coverImage;
        if (saved.authorImage) b.authorImage = saved.authorImage;
        if (saved.author) b.author = saved.author;
      });
    } catch (e) { /* ignore */ }
  }

  restoreBookMedia();
  restoreBookContent();
  renderBooks();
  initTargetBookSelect();
  onTargetBookChange(document.getElementById('upTargetBook').value);
  openBookReader(1);
</script>
</body>
</html>

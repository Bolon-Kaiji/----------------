          <tr>
            <th>রচয়িতা / সংকলক</th>
            <td id="ibAuthor">বলন কাঁইজি</td>
          </tr>
          <tr>
            <th>মূল বিষয়</th>
            <td id="ibSubject">দেহতত্ত্ব, আত্মতত্ত্ব, সৃষ্টিরহস্য</td>
          </tr>
          <tr>
            <th>শাস্ত্রীয় শাখা</th>
            <td id="ibBranch">বৈশ্বিক ধর্মগ্রন্থসমূহ</td>
          </tr>
          <tr>
            <th>ধারাবাহিকতা</th>
            <td id="ibSeries">৮ খণ্ডের ১ম খণ্ড</td>
          </tr>
          <tr>
            <th>প্রকাশনা সংস্থা</th>
            <td>কাঁই ফাউন্ডেশন ট্রাস্ট</td>
          </tr>
          <tr>
            <th>সংস্করণ রূপ</th>
            <td>বিশুদ্ধ সংস্করণ (বলন কাঁইজি রূপ)</td>
          </tr>
          <tr>
            <th>মূল ভাষা</th>
            <td>বাংলা (SolaimanLipi)</td>
          </tr>
          <tr>
            <th>ইংরেজি তর্জমা</th>
            <td class="en-text">English Abstract Incl.</td>
          </tr>
          <tr>
            <th>মোট পরিচ্ছেদ</th>
            <td>১২টি অধ্যায় / ৩৬টি সূত্র</td>
          </tr>
          <tr id="ibFileRow" style="display:none;">
            <th>পাণ্ডুলিপি ফাইল</th>
            <td id="ibFileName"></td>
          </tr>
          <tr>
            <th>ডিজিটাল স্থিতি</th>
            <td style="color:#2ea44f; font-weight:bold;">সংরক্ষিত ও সক্রিয়</td>
          </tr>
        </table>
      </div>
    </aside>

  </div>
</div>

<div id="wikiToast" class="wiki-toast"></div>

<!-- Global Footer -->
<footer class="global-footer">
  <h5>কাঁই ফাউন্ডেশন · বৈশ্বিক আধ্যাত্মিক জ্ঞানকোষ</h5>
  <p>বলন কাঁইজির নির্ভরযোগ্য স্থাপত্য ও মুক্ত তথ্যের আদলে নির্মিত বিশ্বজনীন শাস্ত্রাগার।</p>
  <p style="margin-top:10px; font-size:12px; font-family:var(--font-en);">
    © 2026 Kai Foundation Sacred Text Preservation Project. Fonts: SolaimanLipi & Times New Roman.
  </p>
</footer>

